{
  "name": "Chauffeur",
  "short_name": "Chauffeur",
  "description": "Family driving, schedules, and messages",
  "start_url": "./app",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "photos", "accept": ["image/*"] }]
    }
  },
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#171717",
  "icons": [
    {
      "src": "static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
